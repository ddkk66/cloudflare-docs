---
import StarlightPage, {
	type StarlightPageProps,
} from "@astrojs/starlight/components/StarlightPage.astro";

import HeroImageDark from "~/assets/Dev-Docs-Header-Illustration-Dark-Mode-cropped.svg";
import HeroImageLight from "~/assets/Dev-Docs-Header-Illustration-Light-Mode-cropped.svg";

import { Tabs, TabItem } from "@astrojs/starlight/components";
import Render from "~/components/Render.astro";

import { Image } from "astro:assets";
import { render } from "astro:content";
import { getChangelogs } from "~/util/changelog";

const props = {
	frontmatter: {
		title: "Cloudflare Docs",
		description: "Explore guides and tutorials for using Cloudflare.",
		template: "splash",
	},
	hideTitle: true,
	hideBreadcrumbs: true,
} as StarlightPageProps;

const heroImageAttrs = {
	loading: "eager" as const,
	decoding: "async" as const,
	width: 400,
	height: 400,
	alt: "Hero image",
};

const topCards = [
	{
		label: "Fundamentals",
		href: "/fundamentals/",
		description: "How Cloudflare works and how to get started.",
	},
	{
		label: "Docs directory",
		href: "/products/",
		description: "How to use specific Cloudflare products.",
	},
	{
		label: "Learning paths",
		href: "/learning-paths/",
		description: "Step-by-step walkthroughs on a variety of concepts.",
	},
	{
		label: "Reference architectures",
		href: "/reference-architecture/",
		description: "How our products are designed and architected.",
	},
];

const getStartedCards = [
	{
		label: "Sign up",
		href: "https://dash.cloudflare.com/sign-up",
		description:
			"Create an account on the Cloudflare dashboard to get started.",
	},
	{
		label: "Onboard your domain",
		href: "/fundamentals/setup/manage-domains/add-site/",
		description:
			"Put your website or app behind Cloudflare to boost site speed and fight web attacks like DDoS.",
	},
	{
		label: "Get started with Zero Trust",
		href: "/cloudflare-one/setup/",
		description:
			"Connect a workforce or home network to protect users, devices, data, and private apps.",
	},
	{
		label: "Get started with Workers",
		href: "/workers/get-started/",
		description:
			"Build and scale a simple website or full-stack application. Deploy code globally while Cloudflare handles the infrastructure.",
	},
];

const footer = [
	{
		heading: "Community",
		description:
			"Share ideas, answers, code and compare notes with the Cloudflare community",
		links: [
			{
				label: "Discord",
				href: "https://discord.gg/cloudflaredev",
			},
			{
				label: "Twitter",
				href: "https://twitter.com/cloudflaredev",
			},
			{
				label: "Community forum",
				href: "https://community.cloudflare.com/",
			},
		],
	},
	{
		heading: "Open Source",
		description:
			"Cloudflare contributes to the open-source ecosystem in a variety of ways, including:",
		links: [
			{
				label: "GitHub projects",
				href: "https://github.com/cloudflare/",
			},
			{
				label: "Sponsorship projects",
				href: "/sponsorships/",
			},
			{
				label: "Style guide",
				href: "/style-guide/",
			},
		],
	},
	{
		heading: "Blog",
		description:
			"Get the latest news on Cloudflare products, technologies, and culture.",
		links: [
			{
				label: "Read the blog",
				href: "https://blog.cloudflare.com/",
			},
		],
	},
];

const changelogs = await getChangelogs({}).then((arr) => arr.slice(0, 5));
---

<StarlightPage {...props}>
	<div class="space-y-16">
		<div
			class="flex flex-col-reverse items-center justify-center gap-8 md:flex-row"
		>
			<div>
				<h1 class="text-5xl">Cloudflare Docs</h1>
				<p class="text-xl">
					Explore guides and tutorials for using Cloudflare.
				</p>
			</div>
			<div>
				<Image
					src={HeroImageDark}
					class="light:sl-hidden"
					{...heroImageAttrs}
				/>
				<Image
					src={HeroImageLight}
					class="dark:sl-hidden"
					{...heroImageAttrs}
				/>
			</div>
		</div>
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
			{
				topCards.map((card) => (
					<a
						href={card.href}
						class="rounded-md border border-solid border-gray-200 p-6 !text-inherit no-underline hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"
					>
						<p class="!mt-0 font-semibold">{card.label}</p>
						<div class="leading-2 !mt-1 text-sm">{card.description}</div>
					</a>
				))
			}
		</div>
		<div class="flex flex-col items-center justify-center gap-10">
			<h2>Explore Cloudflare offerings</h2>
			<div class="not-content w-full shadow-md">
				<ul
					role="tablist"
					class="grid list-none grid-cols-3 gap-2 pl-0 text-center"
				>
					{
						["Overview", "Connect & Protect", "Build"].map((label, idx) => (
							<li
								role="presentation"
								class="h-14 rounded-t border-l border-r border-t p-4"
							>
								{label}
							</li>
						))
					}
				</ul>
				<div
					class="grid grid-cols-2 gap-4 rounded-b border-b border-l border-r p-6 lg:grid-cols-4"
				>
					{
						["", "", "", ""].map(() => (
							<div class="flex flex-col items-center gap-4 rounded border p-6 shadow-sm">
								<div class="text-center">
									<p class="font-semibold">For websites & apps</p>
									<p>DNS, CDN, Layer 7, DDoS protection, WAF, and more.</p>
								</div>
								<a class="block min-w-16 text-nowrap rounded border border-cl1-brand-orange px-6">
									Proxy your domain
								</a>
								<a class="block min-w-16 text-nowrap px-6">
									All application services
								</a>
							</div>
						))
					}
				</div>
			</div>
		</div>
		<div class="flex flex-col items-center justify-center gap-10">
			<h2>Get started</h2>
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
				{
					getStartedCards.map((card) => (
						<a
							href={card.href}
							class="rounded-md border border-solid border-gray-200 p-6 !text-inherit no-underline hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800"
						>
							<p class="!mt-0 font-semibold">{card.label}</p>
							<div class="leading-2 !mt-1 text-sm">{card.description}</div>
						</a>
					))
				}
			</div>
		</div>
		<div class="flex w-full flex-col gap-10">
			<div class="flex justify-between">
				<h2>Build with Cloudflare</h2>
				<a href="https://developers.cloudflare.com/workers/">
					Learn more about Workers
				</a>
			</div>
			<div>
				<Tabs>
					<TabItem label="Return HTML">
						<Render file="return-html-example-js" product="workers" />
					</TabItem>
					<TabItem label="Return JSON">
						<Render file="return-json-example-js" product="workers" />
					</TabItem>
					<TabItem label="Fetch HTML">
						<Render file="fetch-html-example-js" product="workers" />
					</TabItem>
					<TabItem label="Redirect">
						<Render file="redirect-example-js" product="workers" />
					</TabItem>
					<TabItem label="Respond with another site">
						<Render file="respond-another-site-example-js" product="workers" />
					</TabItem>
				</Tabs>
			</div>
		</div>
		<div class="flex flex-col items-center justify-center gap-10">
			<h2>Documentation changelog</h2>
			<div class="h-[28rem] w-3/4 overflow-y-scroll rounded border px-6 py-4">
				<ul class="overflow-y-scroll pl-0">
					{
						changelogs.map(async (changelog) => {
							const { Content } = await render(changelog);

							return (
								<li>
									<h5>{changelog.data.title}</h5>
									<div class="line-clamp-4">
										<Content />
									</div>
									<a href={`/changelog/${changelog.id}`}>Read more</a>
								</li>
							);
						})
					}
				</ul>
			</div>
			<a href="/changelog/"> Go to full changelog </a>
		</div>
		<div class="not-content grid grid-cols-1 gap-8 md:grid-cols-3">
			{
				footer.map((group) => (
					<div>
						<p class="text-xs font-medium uppercase">{group.heading}</p>
						<p class="mt-1 text-sm">{group.description}</p>
						<ul class="mt-4 list-none pl-0">
							{group.links.map((item) => (
								<li>
									<a
										href={item.href}
										class="text-sm font-medium !text-black no-underline"
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</StarlightPage>

<style>
	:root {
		.content-panel {
			--sl-content-pad-x: 1rem;

			@media (width >= 48rem) {
				--sl-content-pad-x: 2rem;
			}

			@media (width >= 64rem) {
				--sl-content-pad-x: 4rem;
			}
		}

		.sl-container {
			max-width: 100% !important;
		}
	}
</style>
